# ─── Required ────────────────────────────────────────────────────────────────
PORT=3000
USERNAME=admin
PASSWORD=your-secure-password
JWT_SECRET=your-jwt-secret-change-this

# ─── Database (default: SQLite) ───────────────────────────────────────────────
# DATABASE_URL=moontv.db                                    # SQLite (default)
# DATABASE_URL=mysql://user:pass@localhost:3306/moontv      # MySQL
# DATABASE_URL=postgres://user:pass@localhost:5432/moontv   # PostgreSQL

# ─── Site Configuration ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=MoonTV
ANNOUNCEMENT=

# ─── Douban (optional) ───────────────────────────────────────────────────────
NEXT_PUBLIC_DOUBAN_PROXY_TYPE=
NEXT_PUBLIC_DOUBAN_PROXY=
NEXT_PUBLIC_DOUBAN_IMAGE_PROXY_TYPE=server
NEXT_PUBLIC_DOUBAN_IMAGE_PROXY=

# ─── TMDB (optional) ─────────────────────────────────────────────────────────
TMDB_API_KEY=

# ─── Features ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DISABLE_YELLOW_FILTER=false
DISABLE_HERO_TRAILER=false
NEXT_PUBLIC_SEARCH_MAX_PAGE=5

# ─── Video Cache ─────────────────────────────────────────────────────────────
VIDEO_CACHE_DIR=/tmp/video-cache

# ─── Trusted Networks (auto-login from these CIDRs) ──────────────────────────
TRUSTED_NETWORK_IPS=192.168.1.0/24

# ─── OIDC (optional) ─────────────────────────────────────────────────────────
SITE_BASE=https://your-domain.com
